<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Lab2Relative">

    <TextView
        android:id="@+id/signupTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="Signup"
        android:textSize="32sp"
        android:textStyle="bold"

        android:layout_marginTop="40dp"
        android:layout_centerHorizontal="true"
        />

    <TextView
        android:id="@+id/usernameTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="Username:"
        android:textSize="20sp"

        android:layout_below="@+id/signupTv"
        android:layout_marginTop="40dp"

        android:layout_marginHorizontal="20dp"
        />


    <EditText
        android:id="@+id/usernameEt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:inputType="text"
        android:textSize="18sp"

        android:layout_alignBaseline="@+id/usernameTv"

        android:layout_toEndOf="@+id/usernameTv"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="20dp"
        />

    <TextView
        android:id="@+id/passwordTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="Password:"
        android:textSize="20sp"

        android:layout_below="@+id/usernameTv"
        android:layout_marginTop="25dp"

        android:layout_marginHorizontal="20dp"
        />

    <EditText
        android:id="@+id/passwordEt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:inputType="textPassword"
        android:textSize="18sp"

        android:layout_alignBaseline="@+id/passwordTv"

        android:layout_toEndOf="@+id/usernameTv"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="20dp"
        />

    <TextView
        android:id="@+id/phoneTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="Phone:"
        android:textSize="20sp"

        android:layout_below="@+id/passwordTv"
        android:layout_marginTop="25dp"

        android:layout_marginHorizontal="20dp"
        />

    <EditText
        android:id="@+id/phoneEt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:inputType="phone"
        android:textSize="18sp"

        android:layout_alignBaseline="@+id/phoneTv"

        android:layout_toEndOf="@+id/usernameTv"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="20dp"
        />

    <TextView
        android:id="@+id/fullnameTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="Fullname:"
        android:textSize="20sp"

        android:layout_below="@+id/phoneTv"
        android:layout_marginTop="25dp"

        android:layout_marginHorizontal="20dp"
        />

    <EditText
        android:id="@+id/fullnameEt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:inputType="text"
        android:textSize="18sp"

        android:layout_alignBaseline="@+id/fullnameTv"

        android:layout_toEndOf="@+id/usernameTv"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="20dp"
        />

    <TextView
        android:id="@+id/genderTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="Gender:"
        android:textSize="20sp"

        android:layout_below="@+id/fullnameTv"
        android:layout_marginTop="25dp"

        android:layout_marginHorizontal="20dp"
        />

    <RadioGroup
        android:id="@+id/genderRg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:orientation="horizontal"

        android:layout_alignTop="@id/genderTv"
        android:layout_alignBottom="@id/genderTv"

        android:layout_toEndOf="@id/usernameTv"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="20dp"

        >

        <RadioButton
            android:id="@+id/maleRb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Male"
            android:textSize="16sp"
            />

        <RadioButton
            android:id="@+id/femaleRb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Female"
            android:textSize="16sp"
            />

        <RadioButton
            android:id="@+id/otherRb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Other"
            android:textSize="16sp"
            />

    </RadioGroup>


    <Button
        android:id="@+id/signupBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="Signup"
        android:textSize="20sp"

        android:layout_below="@+id/genderTv"
        android:layout_marginTop="40dp"

        android:layout_centerHorizontal="true"

        />
</RelativeLayout>