<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    >

    <TextView
        android:id="@+id/handleTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Handle Order"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginBottom="20dp"
        />

    <TextView
        android:id="@+id/orderedItemTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Item"

        android:layout_below="@id/handleTv"
        android:textSize="20sp"
        android:layout_margin="20dp"
        />

    <TextView
        android:id="@+id/orderedQtyTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quantity"

        android:layout_below="@id/orderedItemTv"
        android:textSize="20sp"
        android:layout_margin="20dp"
        />

    <TextView
        android:id="@+id/priceTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Price"

        android:layout_below="@id/orderedQtyTv"
        android:textSize="20sp"
        android:layout_margin="20dp"
        />

    <TextView
        android:id="@+id/totalPriceTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Item"

        android:layout_below="@id/priceTv"
        android:textSize="20sp"
        android:layout_margin="20dp"
        />

    <Button
        android:id="@+id/placeOrderBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Confirm"
        android:layout_below="@id/totalPriceTv"
        android:layout_centerHorizontal="true"
        />

</RelativeLayout>